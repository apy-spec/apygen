digraph "overloaded_function" {
    "Constraint()" [label="#return(None)"];
    "Constraint(location=5:4)" [label="#function(identifier=overloaded_function[add@{5:4}], async=false) ⊑ add@{overloaded_function[5:4]} ∧ #defined(add@{overloaded_function[5:4]})"];
    "Constraint(location=9:4)" [label="#function(identifier=overloaded_function[add@{9:4}], async=false) ⊑ add@{overloaded_function[9:4]} ∧ #defined(add@{overloaded_function[9:4]})"];
    "Constraint(location=12:4)" [label="#function(identifier=overloaded_function[add@{12:4}], async=false) ⊑ add@{overloaded_function[12:4]} ∧ #defined(add@{overloaded_function[12:4]})"];
    "Entry" -> "Constraint(location=5:4)" [label="#succeed(#function(identifier=overloaded_function[add@{5:4}], async=false))"];
    "Entry" -> "ExceptionExit" [label="#raise(#function(identifier=overloaded_function[add@{5:4}], async=false))"];
    "Constraint()" -> "TypeExit";
    "Constraint(location=5:4)" -> "Constraint(location=9:4)" [label="#succeed(#function(identifier=overloaded_function[add@{9:4}], async=false))"];
    "Constraint(location=5:4)" -> "ExceptionExit" [label="#raise(#function(identifier=overloaded_function[add@{9:4}], async=false))"];
    "Constraint(location=9:4)" -> "Constraint(location=12:4)" [label="#succeed(#function(identifier=overloaded_function[add@{12:4}], async=false))"];
    "Constraint(location=9:4)" -> "ExceptionExit" [label="#raise(#function(identifier=overloaded_function[add@{12:4}], async=false))"];
    "Constraint(location=12:4)" -> "Constraint()";
    "TypeExit" -> "Exit";
    "ExceptionExit" -> "Exit";
}
