digraph "DependentGraph" {
    "Module(_ast)";
    "Module(_sitebuiltins)";
    "Module(_typeshed)";
    "Module(builtins)";
    "Module(list_operations)";
    "Module(sys)";
    "Module(types)";
    "Entry" -> "Module(builtins)";
    "Module(_ast)" -> "Module(builtins)";
    "Module(_sitebuiltins)" -> "Module(builtins)";
    "Module(_typeshed)" -> "Module(builtins)";
    "Module(builtins)" -> "Module(_ast)";
    "Module(builtins)" -> "Module(_sitebuiltins)";
    "Module(builtins)" -> "Module(_typeshed)";
    "Module(builtins)" -> "Module(list_operations)";
    "Module(builtins)" -> "Module(sys)";
    "Module(builtins)" -> "Module(types)";
    "Module(list_operations)" -> "Exit";
    "Module(sys)" -> "Module(_ast)";
    "Module(sys)" -> "Module(_sitebuiltins)";
    "Module(sys)" -> "Module(_typeshed)";
    "Module(sys)" -> "Module(builtins)";
    "Module(sys)" -> "Module(sys)";
    "Module(sys)" -> "Module(types)";
    "Module(types)" -> "Module(builtins)";
}
digraph "list_operations" {
    "Constraint()" [label="#return(None)"];
    "Constraint(location=1:0)" [label="None ⊑ ls@{list_operations[1:0]} ∧ #defined(ls@{list_operations[1:0]})"];
    "Constraint(location=3:0)" [label="(ls)[0] ⊑ first@{list_operations[3:0]} ∧ #defined(first@{list_operations[3:0]})"];
    "Constraint(location=4:0)" [label="(ls)[1] ⊑ second@{list_operations[4:0]} ∧ #defined(second@{list_operations[4:0]})"];
    "Entry" -> "Constraint(location=1:0)";
    "Constraint()" -> "TypeExit";
    "Constraint(location=1:0)" -> "Constraint(location=3:0)" [label="#succeed((ls)[0])"];
    "Constraint(location=1:0)" -> "ExceptionExit" [label="#raise((ls)[0])"];
    "Constraint(location=3:0)" -> "Constraint(location=4:0)" [label="#succeed((ls)[1])"];
    "Constraint(location=3:0)" -> "ExceptionExit" [label="#raise((ls)[1])"];
    "Constraint(location=4:0)" -> "Constraint()";
    "TypeExit" -> "Exit";
    "ExceptionExit" -> "Exit";
}
