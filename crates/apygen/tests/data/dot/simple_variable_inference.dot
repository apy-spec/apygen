digraph "DependentGraph" {
    "_ast";
    "_sitebuiltins";
    "_typeshed";
    "builtins";
    "simple_variable_inference";
    "sys";
    "types";
    "_ast" -> "builtins";
    "_sitebuiltins" -> "builtins";
    "_typeshed" -> "builtins";
    "builtins" -> "_ast";
    "builtins" -> "_sitebuiltins";
    "builtins" -> "_typeshed";
    "builtins" -> "simple_variable_inference";
    "builtins" -> "sys";
    "builtins" -> "types";
    "sys" -> "_ast";
    "sys" -> "_sitebuiltins";
    "sys" -> "_typeshed";
    "sys" -> "builtins";
    "sys" -> "sys";
    "sys" -> "types";
    "types" -> "builtins";
}
digraph "simple_variable_inference" {
    "Constraint()" [label="#return(None)"];
    "Constraint(location=1:0)" [label="5 ⊑ x@{simple_variable_inference[1:0]} ∧ #defined(x@{simple_variable_inference[1:0]})"];
    "Constraint(location=2:0)" [label="x ⊑ y@{simple_variable_inference[2:0]} ∧ #defined(y@{simple_variable_inference[2:0]})"];
    "Constraint(location=3:0)" [label="(6) and (7) ⊑ z@{simple_variable_inference[3:0]} ∧ #defined(z@{simple_variable_inference[3:0]})"];
    "Constraint(location=4:0)" [label="z ⊑ a@{simple_variable_inference[4:0]} ∧ #defined(a@{simple_variable_inference[4:0]})"];
    "Constraint(location=5:0)" [label="not (True) ⊑ b@{simple_variable_inference[5:0]} ∧ #defined(b@{simple_variable_inference[5:0]})"];
    "Constraint(location=7:0)" [label="10 ⊑ left_int@{simple_variable_inference[7:0]} ∧ #defined(left_int@{simple_variable_inference[7:0]})"];
    "Constraint(location=8:0)" [label="20 ⊑ right_int@{simple_variable_inference[8:0]} ∧ #defined(right_int@{simple_variable_inference[8:0]})"];
    "Constraint(location=9:0)" [label="(left_int) + (right_int) ⊑ sum_int@{simple_variable_inference[9:0]} ∧ #defined(sum_int@{simple_variable_inference[9:0]})"];
    "Entry" -> "Constraint(location=1:0)";
    "Constraint()" -> "TypeExit";
    "Constraint(location=1:0)" -> "Constraint(location=2:0)" [label="#succeed(x)"];
    "Constraint(location=1:0)" -> "ExceptionExit" [label="#raise(x)"];
    "Constraint(location=2:0)" -> "Constraint(location=3:0)" [label="#succeed((6) and (7))"];
    "Constraint(location=2:0)" -> "ExceptionExit" [label="#raise((6) and (7))"];
    "Constraint(location=3:0)" -> "Constraint(location=4:0)" [label="#succeed(z)"];
    "Constraint(location=3:0)" -> "ExceptionExit" [label="#raise(z)"];
    "Constraint(location=4:0)" -> "Constraint(location=5:0)" [label="#succeed(not (True))"];
    "Constraint(location=4:0)" -> "ExceptionExit" [label="#raise(not (True))"];
    "Constraint(location=5:0)" -> "Constraint(location=7:0)";
    "Constraint(location=7:0)" -> "Constraint(location=8:0)";
    "Constraint(location=8:0)" -> "Constraint(location=9:0)" [label="#succeed((left_int) + (right_int))"];
    "Constraint(location=8:0)" -> "ExceptionExit" [label="#raise((left_int) + (right_int))"];
    "Constraint(location=9:0)" -> "Constraint()";
    "TypeExit" -> "Exit";
    "ExceptionExit" -> "Exit";
}
