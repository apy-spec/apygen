digraph "simple_function_argument_inference" {
    "Constraint()" [label="#return(None)"];
    "Constraint(location=1:4)" [label="#function(identifier=simple_function_argument_inference[add_two@{1:4}], async=false) ⊑ add_two@{simple_function_argument_inference[1:4]} ∧ #defined(add_two@{simple_function_argument_inference[1:4]})"];
    "Constraint(location=4:0)" [label="3 ⊑ a@{simple_function_argument_inference[4:0]} ∧ #defined(a@{simple_function_argument_inference[4:0]})"];
    "Constraint(location=5:0)" [label="4 ⊑ b@{simple_function_argument_inference[5:0]} ∧ #defined(b@{simple_function_argument_inference[5:0]})"];
    "Constraint(location=6:0)" [label="(add_two)(a, b) ⊑ result@{simple_function_argument_inference[6:0]} ∧ #defined(result@{simple_function_argument_inference[6:0]})"];
    "Entry" -> "Constraint(location=1:4)" [label="#succeed(#function(identifier=simple_function_argument_inference[add_two@{1:4}], async=false))"];
    "Entry" -> "ExceptionExit" [label="#raise(#function(identifier=simple_function_argument_inference[add_two@{1:4}], async=false))"];
    "Constraint()" -> "TypeExit";
    "Constraint(location=1:4)" -> "Constraint(location=4:0)";
    "Constraint(location=4:0)" -> "Constraint(location=5:0)";
    "Constraint(location=5:0)" -> "Constraint(location=6:0)" [label="#succeed((add_two)(a, b))"];
    "Constraint(location=5:0)" -> "ExceptionExit" [label="#raise((add_two)(a, b))"];
    "Constraint(location=6:0)" -> "Constraint()";
    "TypeExit" -> "Exit";
    "ExceptionExit" -> "Exit";
}
digraph "simple_function_argument_inference[add_two@{1:4}]" {
    "Constraint(location=2:4)" [label="#return((x) + (y))"];
    "Entry" -> "Constraint(location=2:4)" [label="#succeed((x) + (y))"];
    "Entry" -> "ExceptionExit" [label="#raise((x) + (y))"];
    "Constraint(location=2:4)" -> "TypeExit";
    "TypeExit" -> "Exit";
    "ExceptionExit" -> "Exit";
}
